# Sécurité supply-chain : ne JAMAIS exécuter les scripts d'install (pre/post
# install, prepare) des dépendances. Le seul paquet du projet
# (@supabase/supabase-js) est du JS pur, sans étape de build — bloquer les
# scripts n'a aucun effet fonctionnel mais neutralise le vecteur n°1 des
# attaques npm récentes (postinstall malveillant qui exfiltre les secrets).
ignore-scripts=true
# Audit activé, pas de message de financement.
audit=true
fund=false
